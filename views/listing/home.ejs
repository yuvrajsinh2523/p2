<% layout("layout/design.ejs")%>
<body class="main-body">
  
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

      <%for(let data of allData){%>

        <a href="/show/<%=data._id%>" class="show-link">
            <div class="card">
   <img src="<%= data.image.url%>" class="card-img-top" alt="data.image" style="height: 22rem;">
    <div class="card-img-overlay"></div>
   <div class="card-body">
     <p class="card-text">
         Title:<%=data.title%>
         <br>
         <b>Price:&#8377;<%=Number(data.price).toLocaleString("en-IN") %></b>
     </p>
   </div>
 </div>

        </a>
   
  <%}%>
    </div>
  
  

    </body>
