<% layout("layout/design.ejs")%>
<body>


<div class="row">
   
<div class="col-8 offset-2">

   <div class="card show-card ">
   <img src="<%=detail.image.url%>" class="card-img-top show-img" alt="...">
   <br>
   <div class="card-body">
    <p class="card-text">
      <b><%=detail.title%></b> </p>
      <br>
     <b>Descriptions:</b>  <%=detail.description%> <br><br>
     <b> Price:</b> &#8377;<%=detail.price.toLocaleString("en-IN")%> <br>
      


   </div>
   </div>

</div>

   
</div>

<form action="/show/<%=detail._id%>/edit" method="GET">
    <button class="btn btn-dark btn-icon">Click to Change</button>
</form>

</body>
